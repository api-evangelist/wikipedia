        {
          "id": "6034fa60-f6b0-4ac1-ab59-8c0e66a7cc3f",
          "name": "Wikidata Query Service SPARQL Execute a SPARQL Query (GET)",
          "request": {
            "name": "Wikidata Query Service SPARQL Execute a SPARQL Query (GET)",
            "description": {
              "content": "Execute a SPARQL 1.1 SELECT/ASK/CONSTRUCT/DESCRIBE query against the Wikidata graph. Pass the query in the 'query' parameter. Use Accept header to control result format (JSON, XML, CSV, TSV, RDF/XML, Turtle).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "sparql"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "query",
                  "value": "<string>",
                  "description": "(Required) SPARQL query text"
                },
                {
                  "disabled": false,
                  "key": "format",
                  "value": "<string>",
                  "description": "Optional inline format override"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/sparql-results+json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "56e8aaef-d3c4-47f4-9185-87920a18c5f0",
              "name": "Query result",
              "originalRequest": {
