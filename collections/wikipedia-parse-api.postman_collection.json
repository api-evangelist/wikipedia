          "name": "MediaWiki Action Dispatch an Action API Call (GET)",
          "request": {
            "name": "MediaWiki Action Dispatch an Action API Call (GET)",
            "description": {
              "content": "Generic dispatch endpoint for read operations. Use ?action=query for data retrieval, ?action=parse to parse wikitext, ?action=opensearch for auto-complete. Always include format=json. Combine multiple titles with the pipe character (titles=A|B|C). Use the maxlag parameter for non-interactive jobs.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api.php"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "action",
                  "value": "<string>",
                  "description": "(Required) API action to dispatch"
                },
                {
                  "disabled": false,
                  "key": "format",
                  "value": "json",
                  "description": "(Required) Response format. Always use json."
                },
                {
                  "disabled": false,
                  "key": "titles",
                  "value": "<string>",
                  "description": "Pipe-separated list of titles"
                },
                {
                  "disabled": false,
                  "key": "pageids",
                  "value": "<string>",
                  "description": "Pipe-separated list of page IDs"
                },
                {
                  "disabled": false,
                  "key": "prop",
                  "value": "<string>",
                  "description": "Properties to fetch (info|revisions|links|categories|images|extracts|...)"
                },
                {
                  "disabled": false,
                  "key": "list",
                  "value": "<string>",
                  "description": "List generators (allpages|search|recentchanges|categorymembers|...)"
                },
                {
                  "disabled": false,
                  "key": "meta",
                  "value": "<string>",
                  "description": "Meta queries (siteinfo|userinfo|tokens|...)"
                },
                {
                  "disabled": false,
                  "key": "maxlag",
                  "value": "<integer>",
                  "description": "Maximum replication lag in seconds before the request is rejected. Required for bots."
                },
                {
                  "disabled": false,
                  "key": "smaxage",
                  "value": "<integer>",
                  "description": "Shared-cache max-age in seconds"
                },
                {
                  "disabled": false,
                  "key": "maxage",
                  "value": "<integer>",
                  "description": "Cache max-age in seconds"
                }
              ],
              "variable": []
            },
            "header": [
